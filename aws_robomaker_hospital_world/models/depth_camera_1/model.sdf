<?xml version="1.0"?>
<robot name="depth_camera_1" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="world"/>

  <joint name="depth_joint" type="fixed">
    <parent link="world"/>
    <child link="depth_link"/>
  </joint>

  <link name="depth_link">
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
    <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://agv_description/meshes/OTAv07_meshes/zed.stl" />
          </geometry>
          <material name="black">
            <color rgba="1 1 1 1"/>
          </material>
      </visual>

     <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://agv_description/meshes/OTAv07_meshes/zed.stl" />
          </geometry>
          <material name="light_grey">
            <color rgba="0.0 0.0 0.0 0.0"/>
          </material>
      </collision>
  </link>
  
  <gazebo reference="depth_link">
  <sensor name="depth_camera" type="depth">
  <gz_frame_id>depth_camera</gz_frame_id>
  <!-- <child_frame_id>camera_optical_link<child_frame_id> -->
    <update_rate>10</update_rate>
    <pose>0 0 0 0 0 0</pose>
    <camera>
      <horizontal_fov>1</horizontal_fov>
      <image>
        <width>160</width>
        <height>120</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.1</near>
        <far>3.0</far>
      </clip>
    </camera>
    <always_on>1</always_on>
    <visualize>true</visualize>
    <topic>depth_camera_1</topic>
  </sensor>
</gazebo>

</robot>
<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
  <model name="camera_1">
   <static>true</static>
    <link name="camera_1">
      <pose>0 0 0 0 0 0</pose>

         <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://agv_description/meshes/OTAv07_meshes/zed.stl" />
          </geometry>
          <material name="black">
            <color rgba="1 1 1 1"/>
          </material>
      </visual>

      <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://agv_description/meshes/OTAv07_meshes/zed.stl" />
          </geometry>
          <material name="light_grey">
            <color rgba="0.8 0.8 0.8 0.8"/>
          </material>
      </collision>

    </link>
  </model>

